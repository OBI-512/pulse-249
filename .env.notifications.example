# Optional worker-only C3 notification configuration.
# Copy to .env.notifications; the real file is ignored by Git.
FTTW_SMTP_HOST=smtp.example.invalid
FTTW_SMTP_PORT=587
FTTW_SMTP_FROM=fttw@example.invalid
FTTW_SMTP_USERNAME=
FTTW_SMTP_PASSWORD=
FTTW_SMTP_STARTTLS=true

# Notification policies store only env://FTTW_WEBHOOK_NOC, never this URL.
FTTW_WEBHOOK_NOC=https://example.invalid/fttw-webhook
