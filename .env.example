POSTGRES_DB=fttw
POSTGRES_USER=fttw
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+asyncpg://fttw:change-me@postgres:5432/fttw
CORS_ORIGINS=http://localhost:3000
FTTW_ENV=development
SEED_DEMO_DATA=true


# Optional brokered remote access. Normal FTTW operation does not require it.
REMOTE_ACCESS_ENABLED=false
REMOTE_ACCESS_PORT=8010
REMOTE_ACCESS_TICKET_TTL_SECONDS=60
REMOTE_ACCESS_SESSION_MAX_SECONDS=1800
REMOTE_ACCESS_IDLE_TIMEOUT_SECONDS=900
REMOTE_ACCESS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
FTTW_REMOTE_ACCESS_ENV_FILE=./.env.remote_access

# Native Web-GUI proxy (gateway remains disabled unless REMOTE_ACCESS_ENABLED=true)
REMOTE_ACCESS_WEB_ALLOWED_PORTS=80,443,8080,8443
# Separate browser origin for untrusted vendor GUI content; set explicitly in production.
REMOTE_ACCESS_WEB_ORIGIN=
REMOTE_ACCESS_GATEWAY_TLS_ENABLED=false
REMOTE_ACCESS_GATEWAY_EXTERNAL_TLS_TERMINATED=false
# TLS certificate/key references belong in .env.remote_access as env:// references; never commit values.

# Access Templates
# Copy .env.access_templates.example to the live git-ignored file, generate one
# installation-wide 32-byte random master key, and keep that key stable across upgrades/backups.
FTTW_ACCESS_TEMPLATE_ENV_FILE=./.env.access_templates
# Telnet is legacy plaintext transport and remains globally disabled unless explicitly enabled.
TELNET_ACCESS_ENABLED=false

# F3 configuration batches. These initial safety bounds may be lowered but not
# raised above their code-enforced maxima without qualification-backed changes.
CONFIGURATION_BATCH_MAX_TARGETS=100
CONFIGURATION_BATCH_MAX_CONCURRENCY=5
