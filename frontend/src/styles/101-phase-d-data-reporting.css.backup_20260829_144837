/* Phase D workspace uses the same visual language as the rest of the NMS. */
.phase-d-page {
  display: block;
}

.phase-d-page .page-heading {
  margin-bottom: 14px;
}

.phase-d-tabs {
  margin-bottom: 14px !important;
}

.phase-d-stack {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.phase-d-stack > .panel {
  margin: 0;
}

.phase-d-panel-header {
  align-items: flex-start;
  margin-bottom: 14px;
}

.phase-d-panel-header h3 {
  margin: 0 0 3px;
}

.phase-d-panel-header p {
  margin: 0;
  max-width: 920px;
  color: var(--nms-muted);
  font-size: 12.5px;
  line-height: 1.45;
}

.phase-d-panel-header > select {
  width: auto;
  min-width: 150px;
}

.phase-d-summary-grid.stat-grid {
  grid-template-columns: repeat(5, minmax(120px, 1fr));
  gap: 12px;
  margin-bottom: 0;
}

.phase-d-summary-grid .stat-card {
  min-width: 0;
}

.phase-d-inline-form,
.phase-d-file-row,
.phase-d-schedule-form {
  margin-bottom: 0;
}

.phase-d-inline-form > label,
.phase-d-schedule-form > label {
  flex: 0 1 220px;
}

.phase-d-inline-form > button,
.phase-d-file-row > button,
.phase-d-schedule-form > button {
  min-height: 38px;
}

.phase-d-file-row {
  margin-top: 14px;
}

.phase-d-file-row > input[type="file"] {
  flex: 1 1 360px;
  width: auto;
}

.phase-d-page input[type="checkbox"] {
  width: auto;
  accent-color: var(--nms-accent);
}

.compact-input {
  max-width: 100px;
}

.table-subtext {
  display: block;
  margin-top: 3px;
  color: var(--nms-muted);
  font-size: 11px;
}

.phase-d-chart-wrap {
  margin-top: 14px;
}

.phase-d-chart {
  width: 100%;
  height: 240px;
  border: 1px solid var(--nms-border);
  border-radius: 10px;
  background: var(--nms-surface-2);
}

.phase-d-chart line {
  stroke: var(--nms-border-strong);
  stroke-width: 1;
}

.phase-d-chart polyline {
  fill: none;
  stroke: var(--nms-accent);
  stroke-width: 2;
}

.phase-d-chart-meta {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 8px;
  color: var(--nms-muted);
  font-size: 12px;
}

.phase-d-capacity-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 12px;
}

.phase-d-capacity-grid .stat-card {
  margin: 0;
}

.phase-d-capacity-grid .stat-value {
  font-size: 24px;
}

.phase-d-json-cell {
  display: block;
  max-width: 420px;
  overflow: hidden;
  color: var(--nms-code-text);
  background: var(--nms-code);
  border-radius: 5px;
  padding: 3px 6px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phase-d-page .muted-note {
  margin: 10px 0 0;
  color: var(--nms-muted);
  font-size: 12px;
}

.phase-d-report-builder {
  grid-template-columns: minmax(180px, 1fr) minmax(120px, .4fr) minmax(160px, .6fr);
  align-items: end;
  margin-bottom: 0;
}

.phase-d-report-builder .checkbox-label {
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-height: 38px;
  padding-bottom: 2px;
}

.phase-d-report-filter-grid {
  margin-top: 12px;
  margin-bottom: 12px;
}

.phase-d-report-filter-grid .empty-state {
  grid-column: 1 / -1;
  padding: 10px 0;
  text-align: left;
}

.phase-d-record-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 12px;
  max-width: 620px;
  color: var(--nms-text);
  font-size: 12px;
}

.phase-d-record-summary span {
  white-space: nowrap;
}

.phase-d-record-summary strong {
  color: var(--nms-muted);
  font-weight: 600;
}

.phase-d-builder-actions {
  grid-column: 1 / -1;
}

.phase-d-builder-actions > input {
  width: min(320px, 100%);
}

.phase-d-card-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 10px;
}

.phase-d-definition-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  min-height: 86px;
  padding: 13px;
  text-align: left;
  color: var(--nms-text);
  border: 1px solid var(--nms-border);
  border-radius: 10px;
  background: var(--nms-surface-2);
  box-shadow: none;
}

.phase-d-definition-card:hover:not(:disabled) {
  color: var(--nms-text-strong);
  border-color: color-mix(in srgb, var(--nms-accent) 35%, var(--nms-border));
  background: var(--nms-surface-hover);
  transform: none;
  box-shadow: none;
}

.phase-d-definition-card span,
.phase-d-definition-card small {
  color: var(--nms-muted);
}

.phase-d-schedule-form {
  margin-bottom: 14px;
}

.phase-d-schedule-form > input {
  flex: 1 1 220px;
  min-width: 190px;
  width: auto;
}

.phase-d-page h4 {
  color: var(--nms-text-strong);
}

.link-button {
  appearance: none;
  padding: 0;
  text-align: left;
  color: var(--nms-accent-strong);
  border: 0;
  background: none;
  box-shadow: none;
  text-decoration: underline;
  cursor: pointer;
}

.link-button:hover:not(:disabled) {
  color: var(--nms-accent);
  background: none;
  box-shadow: none;
  transform: none;
}

.link-button:disabled {
  opacity: .5;
  cursor: default;
}

@media (max-width: 1000px) {
  .phase-d-summary-grid.stat-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .phase-d-report-builder {
    grid-template-columns: 1fr 1fr;
  }

  .phase-d-card-list {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 700px) {
  .phase-d-summary-grid.stat-grid,
  .phase-d-capacity-grid,
  .phase-d-report-builder,
  .phase-d-card-list {
    grid-template-columns: 1fr;
  }

  .phase-d-panel-header {
    align-items: stretch;
    flex-direction: column;
  }

  .phase-d-panel-header > select {
    width: 100%;
  }
}

.phase-d-exchange-selector {
  margin-bottom: 12px;
}

.phase-d-scope-block {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--nms-border);
}

.phase-d-scope-title {
  margin-bottom: 8px;
  color: var(--nms-text-strong);
  font-size: 12px;
  font-weight: 700;
}

.phase-d-scope-grid {
  margin-bottom: 0;
}

.phase-d-scope-grid label > input + select {
  margin-top: 6px;
}

.phase-d-import-block {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--nms-border);
}

.phase-d-scope-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
.phase-d-scope-title-row .phase-d-scope-title{margin:0}
.clear-filters-button{white-space:nowrap}
.filter-clear-actions{display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-top:8px}

/* Post-refactor report lifecycle management. */
.phase-d-card-actions {
  margin-top: auto;
  padding-top: 8px;
  flex-wrap: wrap;
}

.phase-d-table-actions {
  flex-wrap: wrap;
  min-width: 300px;
}

.phase-d-select-column {
  width: 42px;
  text-align: center;
}

.phase-d-report-editor {
  min-width: min(760px, 78vw);
}

.phase-d-report-editor > label {
  display: grid;
  gap: 6px;
}

/* ENH-B closure: report-management workspace refinement. */
.phase-d-report-view-tabs {
  width: 100%;
  overflow-x: auto;
}

.phase-d-builder-check,
.phase-d-editor-check {
  display: flex;
  align-items: center;
  min-height: 40px;
  padding: 4px 2px;
}

.phase-d-definition-card {
  position: relative;
  gap: 8px;
  min-height: 178px;
  padding: 16px;
  overflow: hidden;
  border-radius: 14px;
  background: linear-gradient(145deg, var(--nms-surface-2), color-mix(in srgb, var(--nms-accent) 3%, var(--nms-surface)));
  box-shadow: 0 8px 24px color-mix(in srgb, var(--nms-text-strong) 5%, transparent);
}

.phase-d-definition-card::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: linear-gradient(180deg, var(--nms-accent), color-mix(in srgb, var(--nms-violet) 55%, var(--nms-accent)));
}

.phase-d-definition-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
}

.phase-d-definition-card-head > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.phase-d-definition-card strong {
  color: var(--nms-text-strong);
  font-size: 15px;
}

.phase-d-definition-card p {
  min-height: 34px;
  margin: 0;
  color: var(--nms-muted);
  font-size: 12px;
  line-height: 1.45;
}

.phase-d-card-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  width: 100%;
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid color-mix(in srgb, var(--nms-border) 72%, transparent);
}

.phase-d-card-actions > button {
  min-width: 0;
  width: 100%;
  justify-content: center;
}

.phase-d-report-editor-page {
  margin: 0;
  overflow: visible;
}

.phase-d-editor-surface {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.phase-d-editor-section {
  padding: 16px;
  border: 1px solid var(--nms-border);
  border-radius: 14px;
  background: var(--nms-surface-2);
}

.phase-d-editor-section > h4 {
  margin: 0 0 13px;
  font-size: 13px;
  letter-spacing: .01em;
}

.phase-d-editor-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px 14px;
  align-items: end;
}

.phase-d-editor-grid > label,
.phase-d-editor-options > label {
  min-width: 0;
}

.phase-d-editor-options {
  display: grid;
  grid-template-columns: minmax(180px, .35fr) minmax(320px, 1fr);
  gap: 14px 20px;
  align-items: start;
}

.phase-d-editor-options > h4 {
  grid-column: 1 / -1;
}

.phase-d-editor-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--nms-border);
}

.phase-d-trash-panel {
  overflow: visible;
}

.phase-d-trash-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.phase-d-trash-column {
  display: flex;
  flex-direction: column;
  gap: 9px;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--nms-border);
  border-radius: 12px;
  background: var(--nms-surface-2);
}

.phase-d-trash-column > h4 {
  margin: 0 0 3px;
}

.phase-d-trash-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px 10px;
  padding: 12px;
  border: 1px solid color-mix(in srgb, var(--nms-border) 88%, transparent);
  border-radius: 10px;
  background: var(--nms-surface);
}

.phase-d-trash-card > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.phase-d-trash-card span,
.phase-d-trash-card small {
  color: var(--nms-muted);
  font-size: 11px;
}

.phase-d-trash-card > small {
  grid-column: 1 / -1;
}

.phase-d-trash-actions {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}

@media (max-width: 980px) {
  .phase-d-card-list,
  .phase-d-trash-grid {
    grid-template-columns: 1fr;
  }
  .phase-d-card-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .phase-d-editor-options {
    grid-template-columns: 1fr;
  }
}

/* ENH-B final UAT refinement: scalable configuration management and editor actions. */
.phase-d-editor-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  margin: 0 0 14px;
  padding: 10px 0 14px;
  border-bottom: 1px solid var(--nms-border);
}

.phase-d-editor-toolbar > :last-child {
  justify-self: end;
}

.phase-d-back-button {
  justify-self: start;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border-color: color-mix(in srgb, var(--nms-muted) 72%, var(--nms-border));
  background: color-mix(in srgb, var(--nms-muted) 52%, var(--nms-surface));
  color: var(--nms-text-strong);
  box-shadow: 0 1px 2px color-mix(in srgb, var(--nms-muted) 18%, transparent);
}

.phase-d-back-button:hover:not(:disabled) {
  border-color: color-mix(in srgb, var(--nms-muted) 82%, var(--nms-border));
  background: color-mix(in srgb, var(--nms-muted) 62%, var(--nms-surface));
  color: var(--nms-text-strong);
  transform: none;
}

.phase-d-config-panel {
  overflow: visible;
}

.phase-d-config-tabs {
  margin-bottom: 12px;
}

.phase-d-config-kind {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin: 0 0 12px;
  padding: 12px;
  border: 1px solid var(--nms-border);
  border-radius: 12px;
  background: var(--nms-surface-2);
}

.phase-d-config-kind label {
  min-width: min(320px, 100%);
}

.phase-d-config-kind small {
  color: var(--nms-muted);
}

.phase-d-config-filters {
  display: grid;
  grid-template-columns: minmax(220px, 1.4fr) repeat(4, minmax(150px, .8fr)) auto;
  gap: 10px;
  align-items: end;
  margin-bottom: 14px;
  padding: 12px;
  border: 1px solid var(--nms-border);
  border-radius: 12px;
  background: var(--nms-surface-2);
}

.phase-d-config-filters > label {
  min-width: 0;
}

.phase-d-config-clear {
  display: flex;
  justify-content: flex-end;
  align-items: end;
  min-height: 40px;
}

.phase-d-config-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
  color: var(--nms-text-2);
}

.phase-d-relationship,
.phase-d-relationship-note {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid color-mix(in srgb, var(--nms-accent) 18%, var(--nms-border));
  border-radius: 9px;
  background: color-mix(in srgb, var(--nms-accent) 4%, var(--nms-surface));
}

.phase-d-relationship strong,
.phase-d-relationship-note strong {
  color: var(--nms-text-strong);
  font-size: 11.5px;
}

.phase-d-relationship span,
.phase-d-relationship-note span {
  overflow: hidden;
  color: var(--nms-muted);
  font-size: 10.5px;
  line-height: 1.4;
  text-overflow: ellipsis;
}

.phase-d-trash-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 10px;
}

.phase-d-trash-card .phase-d-relationship {
  grid-column: 1 / -1;
}

.phase-d-delivery-heading {
  margin-top: 20px;
  padding-top: 14px;
  border-top: 1px solid var(--nms-border);
}

@media (max-width: 1180px) {
  .phase-d-config-filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .phase-d-config-clear {
    justify-content: flex-start;
  }
}

@media (max-width: 680px) {
  .phase-d-editor-toolbar,
  .phase-d-config-filters {
    grid-template-columns: 1fr;
  }
  .phase-d-editor-toolbar > :last-child {
    justify-self: stretch;
  }
  .phase-d-editor-toolbar > button {
    width: 100%;
    justify-content: center;
  }
  .phase-d-config-kind,
  .phase-d-config-toolbar {
    align-items: stretch;
    flex-direction: column;
  }
  .phase-d-trash-list {
    grid-template-columns: 1fr;
  }
}
