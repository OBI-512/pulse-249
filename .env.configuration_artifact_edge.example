# FTTW configuration artifact trusted-edge attestation key.
#
# Generate a dedicated random 32-byte key and encode it as 64 hex characters
# or URL-safe base64. Never reuse the artifact-encryption key, Access Template
# key, SSH credentials, or any user password.
#
# Copy this file to .env.configuration_artifact_edge and keep the real file
# host-local / git-ignored.
FTTW_CONFIGURATION_ARTIFACT_EDGE_HMAC_KEY=replace-with-dedicated-32-byte-key
