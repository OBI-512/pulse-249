FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash fttwmock \
    && mkdir -p /run/sshd

COPY scripts/mock_ssh/sshd_config /etc/ssh/sshd_config
COPY scripts/mock_ssh/entrypoint.sh /usr/local/bin/mock-ssh-entrypoint
RUN chmod 755 /usr/local/bin/mock-ssh-entrypoint \
    && chmod 644 /etc/ssh/sshd_config

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/mock-ssh-entrypoint"]
