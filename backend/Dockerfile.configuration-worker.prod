FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY requirements.txt requirements.lock ./
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends openssh-client sshpass \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -r requirements.lock

COPY alembic.ini .
COPY migrations ./migrations
COPY app ./app
COPY scripts ./scripts

RUN groupadd --gid 10001 fttw \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app --shell /usr/sbin/nologin fttw \
    && mkdir -p /app/data/configurations \
    && chown -R 10001:10001 /app

USER 10001:10001
CMD ["celery", "-A", "app.celery_app.config.celery_app", "worker", "--loglevel=INFO", "--concurrency=1", "-Q", "configuration", "-n", "configuration-worker@%h"]
