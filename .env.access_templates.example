# FTTW Access Templates secret store
#
# Copy this file to .env.access_templates on the deployment host. The live file
# is git-ignored and must be readable only by the FTTW operator/runtime account.
#
# FTTW_ACCESS_TEMPLATE_KEY must be the BASE64 encoding of exactly 32 random bytes.
# Generate it once per installation and preserve it across upgrades/backups.
# Losing or changing this key makes existing ENCRYPTED_DATABASE template secrets
# undecryptable. Never commit, log, or rotate it without a dedicated re-encryption procedure.
FTTW_ACCESS_TEMPLATE_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
